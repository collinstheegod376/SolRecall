{
    "name": "undo-window/solana-undo-escrow",
    "description": "Undo Window for Small Transfers - Solana Escrow System with Delayed Broadcast",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Solana Undo Team",
            "email": "dev@solanaundo.local"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "vlucas/phpdotenv": "^5.5",
        "bramus/router": "^1.6",
        "robthree/twofactorauth": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "cron": "php cron/process_pending.php",
        "seed": "php database/seed.php"
    }
}
