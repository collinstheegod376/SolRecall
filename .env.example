# ==============================================================================
# Solana Undo Escrow Application Configuration
# ==============================================================================

# Application Environment
APP_NAME="Solana Undo Escrow"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_KEY=base64:generate_your_32_byte_app_key_here
APP_ENCRYPTION_KEY=replace_with_32_byte_hex_or_base64_master_encryption_key

# ==============================================================================
# Database Configuration (Supabase PostgreSQL or MySQL)
# ==============================================================================
# OPTION A (Supabase Direct / Pooler Connection String - RECOMMENDED on Vercel):
# DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# OPTION B (Individual variables):
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# ==============================================================================
# Vercel Cron Configuration
# ==============================================================================
# Secret passed in Authorization: Bearer header when Vercel triggers /api/cron
CRON_SECRET=generate_a_random_secret_token_here

# ==============================================================================
# Solana RPC Configuration
# ==============================================================================
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_HOT_WALLET_PUBKEY=
SOLANA_HOT_WALLET_PRIVATE_KEY=

# SPL Token Mint Addresses (Solana Devnet defaults)
SOLANA_TOKEN_MINT_USDC=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_TOKEN_MINT_USDT=EJwZgeZrdCraqiSCdtXYWhWsvQTxZeQXP3ZvGWcvppgw

# Small-Transfer Undo Window Settings (minutes)
DEFAULT_UNDO_WINDOW_MINUTES=10
MIN_UNDO_WINDOW_MINUTES=5
MAX_UNDO_WINDOW_MINUTES=60

# Small-Transfer Thresholds (Transfers <= threshold are eligible for undo hold)
# Transfers above this amount broadcast immediately on-chain.
THRESHOLD_SOL=2.0
THRESHOLD_USDC=100.0
THRESHOLD_USDT=100.0

# Two-Factor Authentication (TOTP)
TWO_FACTOR_ISSUER="SolanaUndoEscrow"

# Google OAuth (Optional external authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://your-project.vercel.app/auth/google/callback"

# Session Management
SESSION_LIFETIME=86400
SESSION_COOKIE_NAME=undo_session
