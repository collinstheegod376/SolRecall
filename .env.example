# ==============================================================================
# Solana Undo Escrow Application Configuration
# ==============================================================================

# Application Environment
APP_NAME="Solana Undo Escrow"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_KEY=base64:generate_your_32_byte_app_key_here
APP_ENCRYPTION_KEY=replace_with_32_byte_hex_or_base64_master_encryption_key

# ==============================================================================
# Pure Supabase Database Configuration (PostgreSQL)
# ==============================================================================
# Transaction Pooler (Port 6543) in EU-West-1:
DATABASE_URL="postgres://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"

DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSLMODE=require

# Supabase API & Project REST Credentials
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ==============================================================================
# Vercel Cron Configuration
# ==============================================================================
# Secret passed in Authorization: Bearer header when Vercel triggers /api/cron
CRON_SECRET=generate_a_random_secret_token_here

# ==============================================================================
# Solana RPC Configuration
# ==============================================================================
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_HOT_WALLET_PUBKEY=
SOLANA_HOT_WALLET_PRIVATE_KEY=

# SPL Token Mint Addresses (Solana Mainnet official mints)
SOLANA_TOKEN_MINT_USDC=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_TOKEN_MINT_USDT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Small-Transfer Undo Window Settings (minutes - supports minutes to years)
DEFAULT_UNDO_WINDOW_MINUTES=10
MIN_UNDO_WINDOW_MINUTES=1
MAX_UNDO_WINDOW_MINUTES=52560000

# Small-Transfer Thresholds (Transfers <= threshold are eligible for undo hold)
THRESHOLD_SOL=2.0
THRESHOLD_USDC=100.0
THRESHOLD_USDT=100.0

# Two-Factor Authentication (TOTP)
TWO_FACTOR_ISSUER="SolanaUndoEscrow"

# Google OAuth (Optional external authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://your-project.vercel.app/auth/google/callback"

# Session Management
SESSION_LIFETIME=86400
SESSION_COOKIE_NAME=undo_session
